{
  "name": "shangri-la-frontier",
  "productName": "香格里拉：虛實邊界",
  "version": "0.1.0",
  "description": "Shangri-La: Realistic Frontier — a sandbox survival/crafting game",
  "main": "main.js",
  "author": "Your Name",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.shangrila.frontier",
    "productName": "Shangri-La Frontier",
    "directories": { "output": "../dist-electron" },
    "files": [
      "**/*",
      "../web/**/*",
      "../assets/**/*"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "../assets/logo/icons/app.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "../assets/logo/icons/logo-1024.png",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "../assets/logo/icons/logo-512.png",
      "category": "Game"
    }
  }
}
